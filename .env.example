# Copia questo file in .env e inserisci ALMENO una chiave.
# Tutto gira nel cloud: le chiavi vanno messe come GitHub Secrets o Colab secrets.

# Provider prioritario (opzionale): anthropic | openai | groq | gemini | openrouter | huggingface | ollama
LLM_PROVIDER=

# Modelli (opzionale, default per provider)
LLM_MODEL=

# Chiavi API (inserisci almeno una)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
HF_TOKEN=

# Ollama (opzionale, locale - disabilitato di default)
OLLAMA_BASE_URL=
